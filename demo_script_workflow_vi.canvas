{
  "nodes": [
    {"id":"n-start","type":"text","text":"Bắt đầu demo_e2e.sh\n(Chạy E2E toàn bộ)","x":-1120,"y":-120,"width":300,"height":110,"color":"1"},

    {"id":"n-topics","type":"text","text":"Tạo/đảm bảo Topics\n- p2.orders (raw)\n- p2.orders.enriched\n- p2.orders.output\n- p2.opb-changelog (compacted)\n- p2.opb-snapshots (compacted)","x":-760,"y":-120,"width":380,"height":170,"color":"4"},

    {"id":"n-opa","type":"text","text":"Khởi động OpA (Chuẩn hoá + EOS)\n- input: p2.orders\n- output: p2.orders.enriched\n- tx-id: opa-tx-1","x":-360,"y":-240,"width":360,"height":140,"color":"1"},
    {"id":"n-opb","type":"text","text":"Khởi động OpB (Stateful + EOS)\n- input: p2.orders.enriched\n- output: p2.orders.output\n- Pebble state, snapshot-interval=5s\n- manifest-sink=both, tx-id=opb-tx-1","x":-360,"y":20,"width":400,"height":190,"color":"1"},

    {"id":"n-force","type":"text","text":"Ép tick đầu tiên\n- bơm 1 ít raw\n- chờ 1×snapshot-interval\n→ có snapshot + manifest","x":40,"y":-240,"width":360,"height":140,"color":"2"},

    {"id":"n-publish","type":"text","text":"Publish manifest\n- Nếu chưa có file: kéo JSON từ Kafka → ghi FS → publish lại","x":40,"y":-80,"width":380,"height":140,"color":"5"},

    {"id":"n-burst","type":"text","text":"Bơm dữ liệu mẫu\n- raw burst nhỏ để quan sát","x":40,"y":80,"width":320,"height":110,"color":"3"},

    {"id":"n-verify","type":"text","text":"Kiểm tra\n- enriched (OpA)\n- manifest (Kafka)\n- changelog (Kafka)","x":440,"y":-120,"width":320,"height":150,"color":"4"},

    {"id":"n-ttr","type":"text","text":"Đo TTR ×3 (OpB)\n- kill/restart OpB\n- bơm marker vào raw\n- chờ output đầu tiên\n→ min/avg/max","x":440,"y":80,"width":360,"height":150,"color":"2"},

    {"id":"n-crash","type":"text","text":"Ma trận crash OpA (EOS)\n- before/mid/after commit\n- read_committed: không partial, exactly-once","x":840,"y":-200,"width":380,"height":170,"color":"2"},

    {"id":"n-lat","type":"text","text":"Độ trễ (5 mẫu)\n- mở consumer trước → bơm 1 record → chờ đúng key\n- dùng WINDOW_SIZE=10 để giảm miss\n- in p50/p95/p99","x":840,"y":20,"width":420,"height":170,"color":"3"},

    {"id":"n-tp","type":"text","text":"Thông lượng (~THR_WINDOW_SEC)\n- mở consumer window rồi bơm HEAVY_N\n- chờ tối đa window+5s rồi kết thúc\n- in: [THROUGHPUT] START/END + count, msgs/s","x":840,"y":200,"width":460,"height":160,"color":"3"},

    {"id":"n-ab","type":"text","text":"A/B: with-changelog vs no-changelog\n- clean state/snapshots mỗi nhánh\n- WITH: chạy 10k → wait_new_snapshot(20s), nếu chưa có: bơm 5 → chờ 10s\n  • ghi: snapshotId, size_kb, changelog_records (from-beginning, timeout 15s)\n- NO: chạy 10k → wait_new_snapshot tương tự (changelog~=0)\n- In: [AB][WITH/NO] … và [AB] SUMMARY","x":1240,"y":40,"width":600,"height":230,"color":"5"},

    {"id":"ex-in","type":"text","text":"Ví dụ raw\n{orderId:\"r1\", productId:\"p1\", price:10000, qty:1, storeId:\"A\"}","x":-760,"y":160,"width":420,"height":110,"color":"3"},
    {"id":"ex-delta","type":"text","text":"Ví dụ delta (changelog)\nkey=A#p1#1694502000, seq=1, delta=10000, deltaQty=1","x":40,"y":200,"width":420,"height":110,"color":"3"},
    {"id":"ex-out","type":"text","text":"Ví dụ output (aggregate)\nkey=A#p1#1694502000, sumAmount=30000, sumQty=3","x":440,"y":-300,"width":420,"height":110,"color":"3"},
    {"id":"ex-man","type":"text","text":"Ví dụ manifest\n{snapshotId:\"2025-10-28T13:35:07Z\", lastChangelogOffset:3}","x":1240,"y":-220,"width":420,"height":110,"color":"3"}
  ],
