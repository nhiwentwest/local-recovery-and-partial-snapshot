{
  "nodes": [
    {"id":"in-enriched","type":"text","x":-900,"y":0,"width":300,"height":120,
     "text":"Input (Kafka)\nTopic: orders.enriched\nKey = orderId\nConsumer: read_committed","color":"4"},

    {"id":"opb-core","type":"text","x":-400,"y":0,"width":520,"height":200,
     "text":"OpB Core\n- Aggregate per window (tumbling --window-size)\n- Build key: storeId#productId#windowStart\n- Update state: sum, count, lastSeq (idempotent)","color":"1"},

    {"id":"state","type":"text","x":200,"y":-240,"width":360,"height":140,
     "text":"State Store\nBackend: Pebble (default) / Memory\nHolds: sum, count, lastSeq per key\nDir: --state-dir","color":"2"},

    {"id":"metrics","type":"text","x":-400,"y":-300,"width":420,"height":150,
     "text":"Metrics & Health\nHTTP: --http (default :8080)\n/metrics (Prometheus), /healthz\nGauges: PartitionLag; Counters: TxProduced/Aborted, ChangelogAppended","color":"3"},

    {"id":"output","type":"text","x":700,"y":0,"width":360,"height":130,
     "text":"Output (Kafka)\nTopic: orders.output\nKey = storeId#productId#windowStart\nOptional EOS: --output-tx-id","color":"4"},

    {"id":"changelog","type":"text","x":-400,"y":260,"width":520,"height":150,
     "text":"Changelog (delta)\nSink: --changelog-sink file|kafka|both\nRecord: { key, seq, delta, deltaQty, ts }\nIdempotency: skip if seq ≤ lastSeq","color":"5"},

    {"id":"snapshot","type":"text","x":200,"y":260,"width":360,"height":140,
     "text":"Snapshotter (filesystem)\nDir: --snapshot-dir\nInterval: --snapshot-interval (s)\nWrites snapshotId folders","color":"2"},

    {"id":"manifest","type":"text","x":620,"y":260,"width":380,"height":140,
     "text":"Manifest (latest)\nSink: --manifest-sink file|kafka|both\n{ snapshotId, lastChangelogOffset }\nKafka key: opb-manifest-latest (compacted)","color":"5"},

    {"id":"restore","type":"text","x":1040,"y":120,"width":420,"height":170,
     "text":"Restore Flow\n1) Read manifest (file|kafka)\n2) Load snapshot (snapshotId)\n3) Replay changelog from offset+1\n4) Continue processing (applied/skipped)","color":"3"},

    {"id":"flags","type":"text","x":-900,"y":-240,"width":300,"height":220,
     "text":"Key Flags\n--group-id (consumer group)\n--kafka-bootstrap\n--window-size (sec)\n--state-backend pebble|memory\n--changelog on|off\n--changelog-sink/source\n--manifest-sink/source\n--output-tx-id (enable EOS output)","color":"6"}
  ],
  "edges": [
    {"id":"e-in-core","fromNode":"in-enriched","fromSide":"right","toNode":"opb-core","toSide":"left","label":"consume (read_committed)"},
    {"id":"e-core-state","fromNode":"opb-core","fromSide":"right","toNode":"state","toSide":"bottom","label":"update sum/count/lastSeq"},
    {"id":"e-core-out","fromNode":"opb-core","fromSide":"right","toNode":"output","toSide":"left","label":"produce orders.output (optional EOS)"},
    {"id":"e-core-changelog","fromNode":"opb-core","fromSide":"bottom","toNode":"changelog","toSide":"top","label":"append Delta (key,seq,delta,ts)"},
    {"id":"e-state-snapshot","fromNode":"state","fromSide":"bottom","toNode":"snapshot","toSide":"top","label":"periodic snapshot"},
    {"id":"e-snapshot-manifest","fromNode":"snapshot","fromSide":"right","toNode":"manifest","toSide":"left","label":"publish latest"},
    {"id":"e-manifest-restore","fromNode":"manifest","fromSide":"right","toNode":"restore","toSide":"left","label":"read manifest"},
    {"id":"e-restore-state","fromNode":"restore","fromSide":"left","toNode":"state","toSide":"right","label":"load + replay"}
  ],
  "version": 1
}
